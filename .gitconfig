[color]
	ui = auto
[user]
	name = Electric Ant
	email = electricant@anche.no
[merge]
	ff = true
	conflictStyle = zdiff3
[push]
	default = simple
	followTags = true
[commit]
	template = /home/pol/.git_commitmsg
[credential]
	helper = cache --timeout=3600
[diff]
	tool = vimdiff
[pull]
	rebase = false
